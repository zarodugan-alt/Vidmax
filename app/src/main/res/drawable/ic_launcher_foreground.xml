<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher foreground: comet streak — cyan head, violet fading tail, night sky. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Tapering tail: gradient stroke from violet (tail) to cyan (head) -->
    <path
        android:pathData="M32,76 C42,66 52,56 66,42"
        android:strokeWidth="3.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startColor="#4D7C4DFF"
                android:endColor="#FF00E5FF"
                android:startX="32"
                android:startY="76"
                android:endX="66"
                android:endY="42"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Comet head glow + core -->
    <path
        android:pathData="M66,42 m-7.5,0 a7.5,7.5 0 1,1 15,0 a7.5,7.5 0 1,1 -15,0"
        android:fillColor="#3300E5FF" />
    <path
        android:pathData="M66,42 m-3.5,0 a3.5,3.5 0 1,1 7,0 a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#00E5FF" />
</vector>
